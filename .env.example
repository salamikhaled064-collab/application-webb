NODE_ENV=development

DATABASE_URL=postgresql://aivideo:aivideo_password@localhost:5432/aivideo

PORT=3001
# Optionnel : sans Redis, la file d'attente est en mémoire (reprise automatique au démarrage)
REDIS_URL=

# Site web (Next.js) -> adresse de l'API, lue au démarrage (pas besoin de rebuild)
API_URL=http://localhost:3001

# openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=

VIDEO_PROVIDER=mock
RUN_WORKER_IN_API=true

# local = un seul serveur | s3 = si l'API et le worker sont des services séparés
STORAGE_PROVIDER=local
STORAGE_DIR=./storage

# Requis uniquement si STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500

# agnes-video-v2.0 est retiré depuis le 25/09/2026
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_CREATE_PATH=/v1/videos
AGNES_RESULT_PATH=/agnesapi
AGNES_MODEL=agnes-video-2.5-flash

DEFAULT_USER_CREDITS=5

# Compte admin créé automatiquement au démarrage de l'API (supprimez le mot de passe ensuite)
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# Adresse PUBLIQUE de l'API (Agnes y télécharge l'image de départ via une URL signée).
# Sur Render elle est fournie automatiquement (RENDER_EXTERNAL_URL).
# PUBLIC_BASE_URL=https://votre-api.onrender.com
