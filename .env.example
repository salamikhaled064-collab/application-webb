NODE_ENV=development

DATABASE_URL=postgresql://aivideo:aivideo_password@localhost:5432/aivideo
REDIS_URL=redis://localhost:6379

PORT=3001
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# openssl rand -hex 32
SESSION_SECRET=
ENCRYPTION_KEY=

VIDEO_PROVIDER=mock
RUN_WORKER_IN_API=true

# local = single machine only | s3 = required for Render multi-service
STORAGE_PROVIDER=local
STORAGE_DIR=./storage

# Required when STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500

AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_CREATE_PATH=/v1/videos
AGNES_RESULT_PATH=/agnesapi
AGNES_MODEL=agnes-video-v2.0

DEFAULT_USER_CREDITS=5

# Temporary only – never commit real values – delete after npm run admin:create
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
